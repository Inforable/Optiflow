# Backend
GEMINI_API_KEY=            # AI Studio key on the billing-linked project (Secret Manager on Cloud Run)
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=
BQ_DATASET=lube
STORAGE_BUCKET=            # Firebase default bucket, e.g. <project>.firebasestorage.app
AI_MODE=live               # live | cached (cached = fixture states, no Gemini calls)
STORE=firestore            # firestore | memory (memory = local dev without GCP)
AUTH_MODE=firebase         # firebase | off (off = local dev only)

# Frontend (Vite)
VITE_API_BASE=             # empty in production (same origin); http://localhost:8080 locally
VITE_USE_FIXTURES=false    # true = screens read /fixtures/*.json, no backend needed
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
